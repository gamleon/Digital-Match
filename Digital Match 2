<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Digital Match – ABB Workshop</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap');
  *{box-sizing:border-box;margin:0;padding:0;}
  html{font-size:16px;}
  body{font-family:'Inter',sans-serif;background:#0f0f1a;color:#fff;min-height:100vh;overflow-x:hidden;padding-bottom:100px;}

  /* HEADER */
  .header{background:linear-gradient(135deg,#FF000F 0%,#cc0009 60%,#1a0003 100%);padding:16px 16px 12px;display:flex;align-items:center;gap:12px;box-shadow:0 4px 30px rgba(255,0,15,0.4);flex-wrap:wrap;}
  .abb-logo{font-size:1.8rem;font-weight:900;letter-spacing:2px;color:#fff;flex-shrink:0;}
  .header-text{flex:1;min-width:150px;}
  .header-text h1{font-size:1.1rem;font-weight:800;color:#fff;text-shadow:0 2px 8px rgba(0,0,0,0.3);line-height:1.2;}
  .header-text p{font-size:0.7rem;color:rgba(255,255,255,0.85);margin-top:2px;}
  .badge{background:rgba(255,255,255,0.2);border:1px solid rgba(255,255,255,0.4);padding:4px 10px;border-radius:20px;font-size:0.65rem;font-weight:600;white-space:nowrap;flex-shrink:0;}

  /* SCOREBOARD */
  .score-bar{background:rgba(255,255,255,0.05);border-bottom:1px solid rgba(255,255,255,0.08);padding:10px 12px;display:flex;gap:8px;overflow-x:auto;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;}
  .team-score{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:6px 12px;display:flex;flex-direction:column;align-items:center;min-width:70px;transition:.3s;flex-shrink:0;}
  .team-score.leader{border-color:#FFD700;background:rgba(255,215,0,0.1);}
  .team-score .tname{font-size:0.65rem;font-weight:700;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:1px;}
  .team-score .tval{font-size:1.3rem;font-weight:800;color:#fff;margin-top:2px;}
  .team-score.leader .tval{color:#FFD700;}

  /* MAIN */
  .main{padding:16px 12px;}
  .instruction{background:linear-gradient(135deg,rgba(255,0,15,0.1),rgba(103,100,246,0.1));border:1px solid rgba(255,0,15,0.3);border-radius:12px;padding:12px 14px;margin-bottom:16px;font-size:0.8rem;color:rgba(255,255,255,0.85);line-height:1.5;}
  .instruction strong{color:#FF000F;}

  /* CARDS GRID */
  .phase-label{font-size:0.85rem;font-weight:700;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px;display:flex;align-items:center;gap:8px;}
  .phase-label::after{content:'';flex:1;height:1px;background:rgba(255,255,255,0.1);}
  
  .columns{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:20px;}
  @media (min-width:600px){.columns{grid-template-columns:repeat(2,1fr);gap:16px;}}
  @media (min-width:1000px){.columns{grid-template-columns:repeat(4,1fr);gap:16px;}}

  .col-header{text-align:center;padding:8px;border-radius:8px;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;sticky:top;}
  .col-dor .col-header{background:rgba(255,100,0,0.25);color:#ff9040;border:1px solid rgba(255,100,0,0.3);}
  .col-dado .col-header{background:rgba(103,100,246,0.25);color:#93a1ff;border:1px solid rgba(103,100,246,0.3);}
  .col-solucao .col-header{background:rgba(255,0,15,0.25);color:#ff6070;border:1px solid rgba(255,0,15,0.3);}
  .col-valor .col-header{background:rgba(0,200,100,0.2);color:#40e080;border:1px solid rgba(0,200,100,0.25);}

  .card{background:rgba(255,255,255,0.05);border:2px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px 10px;font-size:0.75rem;line-height:1.4;cursor:pointer;transition:.25s;user-select:none;position:relative;min-height:60px;display:flex;align-items:center;text-align:center;touch-action:manipulation;}
  .card:hover{transform:translateY(-2px);border-color:rgba(255,255,255,0.3);background:rgba(255,255,255,0.09);}
  .card:active{transform:translateY(-1px);}
  .card.selected{border-color:#FF000F;background:rgba(255,0,15,0.15);transform:translateY(-2px);}
  .card.matched{border-color:#40e080;background:rgba(0,200,100,0.12);cursor:default;opacity:.75;}
  .card.matched::after{content:'✓';position:absolute;top:4px;right:6px;color:#40e080;font-weight:800;font-size:1rem;}
  .card.wrong{border-color:#ff4444;background:rgba(255,0,0,0.15);animation:shake .4s;}
  @keyframes shake{0%,100%{transform:translateX(0);}25%{transform:translateX(-4px);}75%{transform:translateX(4px);};}

  .col-dor .card.selected{border-color:#ff9040;}
  .col-dado .card.selected{border-color:#93a1ff;}
  .col-valor .card.selected{border-color:#40e080;}

  /* RESULT AREA */
  .result-area{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:12px;margin-top:12px;}
  .result-area h3{font-size:0.9rem;font-weight:700;margin-bottom:10px;color:rgba(255,255,255,0.7);}
  .match-row{display:grid;grid-template-columns:1fr;gap:8px;margin-bottom:10px;align-items:stretch;}
  @media (min-width:600px){.match-row{grid-template-columns:repeat(4,1fr);}}
  .match-cell{background:rgba(255,255,255,0.06);border-radius:8px;padding:8px;font-size:0.7rem;text-align:center;line-height:1.3;}

  /* BUTTONS */
  .btn-row{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:14px;}
  @media (min-width:600px){.btn-row{grid-template-columns:repeat(4,1fr);}}
  .btn{padding:12px 14px;border-radius:8px;font-size:0.8rem;font-weight:700;border:none;cursor:pointer;transition:.2s;letter-spacing:.4px;width:100%;touch-action:manipulation;}
  .btn-red{background:#FF000F;color:#fff;}
  .btn-red:active{background:#cc0009;transform:scale(.98);}
  .btn-ghost{background:transparent;color:#fff;border:1px solid rgba(255,255,255,0.2);}
  .btn-ghost:active{background:rgba(255,255,255,0.1);}

  /* MODAL */
  .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.8);display:flex;align-items:center;justify-content:center;z-index:100;opacity:0;pointer-events:none;transition:.3s;padding:16px;}
  .modal-overlay.show{opacity:1;pointer-events:all;}
  .modal{background:#1a1a2e;border:1px solid rgba(255,0,15,0.3);border-radius:16px;padding:24px 16px;max-width:100%;width:100%;max-width:400px;text-align:center;transform:scale(.9);transition:.3s;}
  .modal-overlay.show .modal{transform:scale(1);}
  .modal .icon{font-size:2.5rem;margin-bottom:8px;}
  .modal h2{font-size:1.2rem;font-weight:800;margin-bottom:8px;}
  .modal p{color:rgba(255,255,255,0.7);font-size:0.85rem;line-height:1.5;margin-bottom:16px;}
  .progress-bar{background:rgba(255,255,255,0.1);border-radius:6px;height:6px;overflow:hidden;margin-bottom:4px;}
  .progress-fill{background:linear-gradient(90deg,#FF000F,#6764f6);height:100%;border-radius:6px;transition:.5s;}

  /* TIMER */
  .timer-widget{position:fixed;bottom:16px;right:16px;background:#1a1a2e;border:2px solid rgba(255,0,15,0.4);border-radius:12px;padding:10px 14px;text-align:center;box-shadow:0 8px 30px rgba(0,0,0,0.4);z-index:50;}
  .timer-label{font-size:0.65rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,0.5);margin-bottom:2px;}
  .timer-value{font-size:1.6rem;font-weight:800;color:#FF000F;font-variant-numeric:tabular-nums;}
  .timer-value.warning{color:#FFD700;animation:pulse 1s infinite;}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.5;};}

  /* Progress */
  .progress-section{margin-bottom:14px;}
  .progress-section p{font-size:0.75rem;color:rgba(255,255,255,.5);margin-bottom:4px;display:flex;justify-content:space-between;}
</style>
</head>
<body>

<!-- HEADER -->
<div class="header">
  <div class="abb-logo">ABB</div>
  <div class="header-text">
    <h1>🔗 Digital Match</h1>
    <p>Workshop • 20/08/2026 • AUPI</p>
  </div>
  <div class="badge">Dinâmica 1</div>
</div>

<!-- SCOREBOARD -->
<div class="score-bar" id="scoreBoard">
  <div class="team-score" id="t1"><span class="tname">Time 1</span><span class="tval" id="s1">0</span></div>
  <div class="team-score" id="t2"><span class="tname">Time 2</span><span class="tval" id="s2">0</span></div>
  <div class="team-score" id="t3"><span class="tname">Time 3</span><span class="tval" id="s3">0</span></div>
  <div class="team-score" id="t4"><span class="tname">Time 4</span><span class="tval" id="s4">0</span></div>
  <div class="team-score" id="t5"><span class="tname">Time 5</span><span class="tval" id="s5">0</span></div>
  <div class="team-score" id="t6"><span class="tname">Time 6</span><span class="tval" id="s6">0</span></div>
</div>

<!-- MAIN -->
<div class="main">
  <div style="background:rgba(255,255,255,0.08);border-radius:10px;padding:10px;margin-bottom:12px;display:flex;gap:6px;align-items:center;justify-content:space-between;font-size:0.75rem;font-weight:700;">
    <span id="currentTeamLabel" style="color:#FF000F;">Time 1 Ativo</span>
    <div style="display:flex;gap:4px;">
      <button class="btn btn-ghost" style="padding:6px 10px;font-size:.75rem;width:auto;" onclick="switchTeam(-1)">◀</button>
      <button class="btn btn-ghost" style="padding:6px 10px;font-size:.75rem;width:auto;" onclick="switchTeam(1)">▶</button>
    </div>
  </div>

  <div class="instruction">
    <strong>Como jogar:</strong> Selecione 1 card de cada coluna que formem um conjunto. Acerto = <strong>+10 pts</strong> · Erro = <strong>-2 pts</strong>.
  </div>

  <!-- ROUND PROGRESS -->
  <div class="progress-section">
    <p><span>Progresso</span><span id="matchCount">0 / 6</span></p>
    <div class="progress-bar"><div class="progress-fill" id="matchProgress" style="width:0%"></div></div>
  </div>

  <!-- COLUMNS -->
  <div class="phase-label">Conecte os 4 elementos</div>
  <div class="columns">
    <!-- COL DOR -->
    <div class="col-dor">
      <div class="col-header">😣 Dor</div>
      <div class="card" onclick="selectCard(this,'dor',0)" data-id="0">Consumo de energia excessivo sem visibilidade</div>
      <div class="card" onclick="selectCard(this,'dor',1)" data-id="1">Equipamentos críticos param sem aviso</div>
      <div class="card" onclick="selectCard(this,'dor',2)" data-id="2">Processo industrial oscila muito</div>
      <div class="card" onclick="selectCard(this,'dor',3)" data-id="3">Dificuldade em rastrear a produção</div>
      <div class="card" onclick="selectCard(this,'dor',4)" data-id="4">Inspeção manual é lenta e cara</div>
      <div class="card" onclick="selectCard(this,'dor',5)" data-id="5">Dados dispersos em silos</div>
    </div>
    <!-- COL DADO -->
    <div class="col-dado">
      <div class="col-header">📊 Dado</div>
      <div class="card" onclick="selectCard(this,'dado',3)" data-id="3">Consumo em tempo real</div>
      <div class="card" onclick="selectCard(this,'dado',1)" data-id="1">Vibração, temperatura e corrente</div>
      <div class="card" onclick="selectCard(this,'dado',0)" data-id="0">Temperatura, pressão, fluxo</div>
      <div class="card" onclick="selectCard(this,'dado',2)" data-id="2">Ordens, receitas e qualidade</div>
      <div class="card" onclick="selectCard(this,'dado',4)" data-id="4">Imagens de alta resolução</div>
      <div class="card" onclick="selectCard(this,'dado',5)" data-id="5">Tags de múltiplas fontes</div>
    </div>
    <!-- COL SOLUCAO -->
    <div class="col-solucao">
      <div class="col-header">⚙️ Solução</div>
      <div class="card" onclick="selectCard(this,'solucao',2)" data-id="2">APC</div>
      <div class="card" onclick="selectCard(this,'solucao',1)" data-id="1">AssetVista</div>
      <div class="card" onclick="selectCard(this,'solucao',4)" data-id="4">Camera Connect</div>
      <div class="card" onclick="selectCard(this,'solucao',0)" data-id="0">EMS</div>
      <div class="card" onclick="selectCard(this,'solucao',3)" data-id="3">KM/MES</div>
      <div class="card" onclick="selectCard(this,'solucao',5)" data-id="5">Genix</div>
    </div>
    <!-- COL VALOR -->
    <div class="col-valor">
      <div class="col-header">💰 Valor</div>
      <div class="card" onclick="selectCard(this,'valor',2)" data-id="2">Redução de 8–15% em variações</div>
      <div class="card" onclick="selectCard(this,'valor',1)" data-id="1">Redução de 30–40% em falhas</div>
      <div class="card" onclick="selectCard(this,'valor',4)" data-id="4">Detecção 24/7 com 95% precisão</div>
      <div class="card" onclick="selectCard(this,'valor',0)" data-id="0">Redução de 10–20% energia</div>
      <div class="card" onclick="selectCard(this,'valor',3)" data-id="3">Rastreabilidade total</div>
      <div class="card" onclick="selectCard(this,'valor',5)" data-id="5">Insights preditivos</div>
    </div>
  </div>

  <!-- RESULT AREA -->
  <div class="result-area" id="resultArea">
    <h3>✅ Associações</h3>
    <div id="matchRows"><p style="color:rgba(255,255,255,.3);font-size:.8rem;">Nenhuma associação ainda...</p></div>
  </div>

  <div class="btn-row">
    <button class="btn btn-red" onclick="confirmMatch()">Confirmar</button>
    <button class="btn btn-ghost" onclick="clearSelection()">Limpar</button>
    <button class="btn btn-ghost" onclick="resetGame()">Reiniciar</button>
    <button class="btn btn-ghost" onclick="toggleTimer()">Timer</button>
  </div>
</div>

<!-- TIMER -->
<div class="timer-widget">
  <div class="timer-label">Tempo</div>
  <div class="timer-value" id="timerDisplay">35:00</div>
</div>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="icon" id="modalIcon">🎉</div>
    <h2 id="modalTitle">Excelente!</h2>
    <p id="modalMsg"></p>
    <div class="progress-bar"><div class="progress-fill" id="modalProg" style="width:0%"></div></div>
    <p id="modalSub" style="font-size:.75rem;color:rgba(255,255,255,.4);margin-top:4px;margin-bottom:12px;"></p>
    <button class="btn btn-red" onclick="closeModal()">Continuar</button>
  </div>
</div>

<script>
const scores = [0,0,0,0,0,0];
let currentTeam = 0;
let selection = {dor:null,dado:null,solucao:null,valor:null};
let selectedEls = {dor:null,dado:null,solucao:null,valor:null};
let matchedCount = 0;

// Timer
let timerSeconds = 35*60;
let timerRunning = false;
let timerInterval = null;

function updateTimerDisplay(){
  const m = Math.floor(timerSeconds/60);
  const s = timerSeconds % 60;
  const el = document.getElementById('timerDisplay');
  el.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  el.className = 'timer-value' + (timerSeconds <= 300 ? ' warning' : '');
}

function toggleTimer(){
  if(timerRunning){
    clearInterval(timerInterval);
    timerRunning = false;
  } else {
    timerInterval = setInterval(()=>{
      if(timerSeconds > 0){ timerSeconds--; updateTimerDisplay(); }
      else { clearInterval(timerInterval); timerRunning=false; showModal('⏰','Tempo Esgotado!','O tempo para esta rodada acabou.',''); }
    },1000);
    timerRunning = true;
  }
}

function switchTeam(dir){
  currentTeam = (currentTeam + dir + 6) % 6;
  document.getElementById('currentTeamLabel').textContent = `Time ${currentTeam+1} Ativo`;
  clearSelection();
  updateLeader();
}

function updateLeader(){
  const max = Math.max(...scores);
  for(let i=0;i<6;i++){
    const el = document.getElementById(`t${i+1}`);
    el.className = 'team-score' + (scores[i]===max && max>0 ? ' leader':'');
    document.getElementById(`s${i+1}`).textContent = scores[i];
  }
}

function selectCard(el, col, id){
  if(el.classList.contains('matched')) return;
  if(selectedEls[col]){
    selectedEls[col].classList.remove('selected');
  }
  if(selectedEls[col] === el){
    selectedEls[col] = null;
    selection[col] = null;
    return;
  }
  el.classList.add('selected');
  selectedEls[col] = el;
  selection[col] = parseInt(el.dataset.id);
}

function confirmMatch(){
  const {dor,dado,solucao,valor} = selection;
  if(dor===null||dado===null||solucao===null||valor===null){
    showModal('⚠️','Seleção Incompleta','Selecione um card de cada coluna!','');
    return;
  }
  if(dor===dado && dado===solucao && solucao===valor){
    scores[currentTeam] += 10;
    ['dor','dado','solucao','valor'].forEach(c=>{
      selectedEls[c].classList.remove('selected');
      selectedEls[c].classList.add('matched');
    });
    matchedCount++;
    addMatchRow(selectedEls.dor.textContent, selectedEls.dado.textContent, selectedEls.solucao.textContent, selectedEls.valor.textContent, true);
    const pct = (matchedCount/6)*100;
    document.getElementById('matchProgress').style.width = pct+'%';
    document.getElementById('matchCount').textContent = `${matchedCount} / 6`;
    clearSelection(false);
    updateLeader();
    if(matchedCount===6){
      showModal('🏆','Parabéns!',`Todas as 6 soluções associadas! Time ${currentTeam+1} conquistou ${scores[currentTeam]} pontos!`,`Pontuação: ${scores[currentTeam]}`);
    } else {
      showModal('✅','Correto! +10 pts',`Ótima associação!`,`Time ${currentTeam+1} → ${scores[currentTeam]} pts`);
    }
  } else {
    scores[currentTeam] = Math.max(0, scores[currentTeam]-2);
    ['dor','dado','solucao','valor'].forEach(c=>{
      if(selectedEls[c]){ selectedEls[c].classList.add('wrong'); setTimeout(()=>selectedEls[c].classList.remove('wrong'),500); }
    });
    updateLeader();
    showModal('❌','Incorreta! -2 pts','Os elementos não formam um conjunto coerente.',`Time ${currentTeam+1} → ${scores[currentTeam]} pts`);
    clearSelection(false);
  }
}

function addMatchRow(dor,dado,sol,val,correct){
  const container = document.getElementById('matchRows');
  if(container.querySelector('p')) container.innerHTML='';
  const row = document.createElement('div');
  row.className = 'match-row';
  row.innerHTML = `
    <div class="match-cell" style="border:1px solid rgba(255,144,64,.3);">${dor}</div>
    <div class="match-cell" style="border:1px solid rgba(147,161,255,.3);">${dado}</div>
    <div class="match-cell" style="border:1px solid rgba(255,0,15,.3);">${sol}</div>
    <div class="match-cell" style="border:1px solid rgba(64,224,128,.3);">${val}</div>
  `;
  container.appendChild(row);
}

function clearSelection(resetEls=true){
  ['dor','dado','solucao','valor'].forEach(c=>{
    if(selectedEls[c]&&!selectedEls[c].classList.contains('matched')) selectedEls[c].classList.remove('selected');
    if(resetEls){ selectedEls[c]=null; selection[c]=null; }
  });
  if(resetEls){selection={dor:null,dado:null,solucao:null,valor:null};selectedEls={dor:null,dado:null,solucao:null,valor:null};}
}

function resetGame(){
  document.querySelectorAll('.card').forEach(c=>{c.className='card';});
  scores.fill(0); matchedCount=0; timerSeconds=35*60;
  clearInterval(timerInterval); timerRunning=false;
  updateTimerDisplay(); updateLeader();
  document.getElementById('matchRows').innerHTML='<p style="color:rgba(255,255,255,.3);font-size:.8rem;">Nenhuma associação ainda...</p>';
  document.getElementById('matchProgress').style.width='0%';
  document.getElementById('matchCount').textContent='0 / 6';
  selection={dor:null,dado:null,solucao:null,valor:null};
  selectedEls={dor:null,dado:null,solucao:null,valor:null};
}

function showModal(icon,title,msg,sub){
  document.getElementById('modalIcon').textContent=icon;
  document.getElementById('modalTitle').textContent=title;
  document.getElementById('modalMsg').innerHTML=msg;
  document.getElementById('modalSub').textContent=sub;
  document.getElementById('modalOverlay').classList.add('show');
}
function closeModal(){ document.getElementById('modalOverlay').classList.remove('show'); }
</script>
</body>
</html>
